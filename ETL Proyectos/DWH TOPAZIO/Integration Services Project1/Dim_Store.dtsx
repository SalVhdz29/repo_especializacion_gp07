              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.String"
                  description="The name of the table to be fetched."
                  expressionType="Notify"
                  name="TableName"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.store_id,
    s.name AS store_name,
    (SELECT CAST(value AS VARCHAR(255)) FROM core_config_data WHERE path = CONCAT('stores/', s.store_id, '/general/store_information/street_address')) AS address,
    (SELECT CAST(value AS VARCHAR(255)) FROM core_config_data WHERE path = CONCAT('stores/', s.store_id, '/general/store_information/city')) AS city,
    (SELECT CAST(value AS VARCHAR(255)) FROM core_config_data WHERE path = CONCAT('stores/', s.store_id, '/general/store_information/region_id')) AS region,
    (SELECT CAST(value AS VARCHAR(255)) FROM core_config_data WHERE path = CONCAT('stores/', s.store_id, '/general/store_information/manager_name')) AS manager_name
FROM
    store s;
</property>
