                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)(([YEAR](#{Package\Data Flow Task\script odoo 16.Outputs[ODBC Source Output].Columns[lote_date_entera]}) * 10000) + ([MONTH](#{Package\Data Flow Task\script odoo 16.Outputs[ODBC Source Output].Columns[lote_date_entera]}) * 100) + [DAY](#{Package\Data Flow Task\script odoo 16.Outputs[ODBC Source Output].Columns[lote_date_entera]}))</property>
