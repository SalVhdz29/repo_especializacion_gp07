                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\lotedatekey.Outputs[Derived Column Output].Columns[lotedatekey]"
                      name="lotedatekey"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)(([YEAR](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[lote_date_entera]}) * 10000) + ([MONTH](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[lote_date_entera]}) * 100) + [DAY](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[lote_date_entera]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_I4)((YEAR(lote_date_entera) * 10000) + (MONTH(lote_date_entera) * 100) + DAY(lote_date_entera))</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Data Flow Task\lotedatekey.Outputs[Derived Column Output].Columns[loteproductiontime]"
                      dataType="i4"
                      errorOrTruncationOperation="Computation"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\lotedatekey.Outputs[Derived Column Output].Columns[loteproductiontime]"
                      name="loteproductiontime"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)([DATEDIFF]("MINUTE",#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[fecha_inicio]},#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[fecha_fin]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_I4)(DATEDIFF("MINUTE",fecha_inicio,fecha_fin))</property>
                      </properties>
                    </outputColumn>
