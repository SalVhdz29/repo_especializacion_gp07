                  name="ParameterMap">#{Package\Data Flow Task\src Magento.Outputs[ODBC Source Output].Columns[customer_bk]};#{Package\Data Flow Task\src Magento.Outputs[ODBC Source Output].Columns[customer_name]};#{Package\Data Flow Task\src Magento.Outputs[ODBC Source Output].Columns[customer_email]};</property>
