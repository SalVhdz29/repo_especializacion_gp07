                      errorRowDisposition="FailComponent"
                      lineageId="Package\Data Flow Task\Movement Date Key.Outputs[Derived Column Output].Columns[movement_date_key]"
                      name="movement_date_key"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_I4)(([YEAR](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[date_finished]}) * 10000) + ([MONTH](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[date_finished]}) * 100) + [DAY](#{Package\Data Flow Task\ODBC Source.Outputs[ODBC Source Output].Columns[date_finished]}))</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_I4)((YEAR(date_finished) * 10000) + (MONTH(date_finished) * 100) + DAY(date_finished))</property>
                      </properties>
                    </outputColumn>
                  </outputColumns>
                  <externalMetadataColumns />
                </output>
